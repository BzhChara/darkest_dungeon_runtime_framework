{
  "id": "validation.boss_gauntlet_campaign_contract",
  "name": "Validation - Boss Gauntlet Campaign Contract",
  "version": "0.1.0",
  "enabled": true,
  "capabilities": [
    "state.sidecar",
    "profile.detect_new_or_uninitialized",
    "profile.mark_initialized",
    "roster.ensure_class_instances",
    "roster.set_progression",
    "roster.set_skill_unlocks",
    "upgrade.ensure_purchases",
    "stagecoach.suppress_recruits",
    "estate.ensure_inventory_counts",
    "wallet.set_currency_amount",
    "wallet.set_currency_amounts",
    "wallet.modify_currency",
    "trinket.patch_entry",
    "campaign.reset_plot_progress",
    "town.unlock_all_buildings",
    "town.suppress_store_items",
    "quest_board.replace_with_fixed_set",
    "quest_board.filter_completed_fixed_quests",
    "quest.observe_selection_confirmed",
    "party.observe_selection_confirmed",
    "equipment.observe_loadout_confirmed",
    "quest.observe_attempt_resolved",
    "attempt.record_once",
    "selection.lock",
    "selection.consume_heroes",
    "selection.consume_trinkets",
    "quest.mark_completed",
    "state.transition_phase",
    "quest.chain.define",
    "progression.observe_plot_completion"
  ],
  "phase": "normal",
  "priority": 16,
  "virtualFileRules": [],
  "questChains": [
    {
      "id": "boss_gauntlet_darkest_finale_chain",
      "name": "Boss Gauntlet Darkest Finale Chain",
      "mode": "linear_progression",
      "unlock": {
        "type": "stateEquals",
        "stateKey": "bossGauntlet.phase",
        "stateEquals": "darkest_finale"
      },
      "questBoard": {
        "enabled": true,
        "mode": "linearProgression",
        "questIdSource": "sourceQuestId",
        "refreshTriggers": [
          "immediateOnQuestComplete",
          "onWeekAdvance",
          "manual"
        ],
        "onCompleted": "remove"
      },
      "stages": [
        {
          "id": "dd1",
          "name": "Darkest Dungeon I",
          "order": 0,
          "sourceQuestId": "plot_darkest_dungeon_1",
          "region": "darkestdungeon",
          "difficulty": 6,
          "tags": [
            "finale"
          ]
        },
        {
          "id": "dd2",
          "name": "Darkest Dungeon II",
          "order": 1,
          "sourceQuestId": "plot_darkest_dungeon_2",
          "region": "darkestdungeon",
          "difficulty": 6,
          "tags": [
            "finale"
          ]
        },
        {
          "id": "dd3",
          "name": "Darkest Dungeon III",
          "order": 2,
          "sourceQuestId": "plot_darkest_dungeon_3",
          "region": "darkestdungeon",
          "difficulty": 6,
          "tags": [
            "finale"
          ]
        },
        {
          "id": "dd4",
          "name": "Darkest Dungeon IV",
          "order": 3,
          "sourceQuestId": "plot_darkest_dungeon_4",
          "region": "darkestdungeon",
          "difficulty": 6,
          "tags": [
            "finale"
          ]
        }
      ]
    }
  ],
  "factEventRules": [
    {
      "id": "emit_boss_selection_confirmed_from_active_raid",
      "enabled": true,
      "emit": "quest.selection_confirmed",
      "phase": "normal",
      "priority": -10,
      "requiresCapabilities": [
        "state.sidecar",
        "quest.observe_selection_confirmed",
        "party.observe_selection_confirmed",
        "equipment.observe_loadout_confirmed"
      ],
      "when": {
        "all": [
          {
            "state": "bossGauntlet.initialized",
            "op": "equals",
            "value": true
          },
          {
            "state": "bossGauntlet.phase",
            "op": "equals",
            "value": "boss_gauntlet"
          },
          {
            "state": "bossGauntlet.activeSelection.questId",
            "op": "notExists"
          },
          {
            "fact": "raid.instance.id",
            "op": "exists"
          },
          {
            "state": "bossGauntlet.fixedQuestIds",
            "op": "contains",
            "valueFromFact": "raid.instance.id"
          },
          {
            "fact": "raid.party.heroCount",
            "op": "greater",
            "value": 0
          }
        ]
      },
      "payload": {
        "questId": {
          "fromFact": "raid.instance.id"
        },
        "selectedHeroIds": {
          "fromFact": "raid.party.heroGuids",
          "map": "stringArray"
        },
        "selectedTrinketIds": {
          "fromFact": "heroes",
          "whereIn": {
            "path": "id",
            "valuesFromFact": "raid.party.heroGuids"
          },
          "selectMany": "trinketIds",
          "selectManyMissing": "skip",
          "map": "stringArray",
          "distinct": true
        },
        "saveStateReportPath": {
          "fromBridge": "saveStateReportPath"
        }
      }
    },
    {
      "id": "emit_boss_selection_confirmed_from_completed_campaign_log",
      "enabled": true,
      "emit": "quest.selection_confirmed",
      "phase": "normal",
      "priority": -5,
      "requiresCapabilities": [
        "state.sidecar",
        "quest.observe_selection_confirmed",
        "party.observe_selection_confirmed",
        "equipment.observe_loadout_confirmed"
      ],
      "when": {
        "all": [
          {
            "state": "bossGauntlet.initialized",
            "op": "equals",
            "value": true
          },
          {
            "state": "bossGauntlet.phase",
            "op": "equals",
            "value": "boss_gauntlet"
          },
          {
            "state": "bossGauntlet.activeSelection.questId",
            "op": "notExists"
          },
          {
            "fact": "campaignLog.latestCompletedPartyRaidRecord.questId.names.0",
            "op": "exists"
          },
          {
            "state": "bossGauntlet.fixedQuestIds",
            "op": "contains",
            "valueFromFact": "campaignLog.latestCompletedPartyRaidRecord.questId.names.0"
          },
          {
            "fact": "campaignLog.latestCompletedPartyRaidRecord.start",
            "op": "equals",
            "value": false
          }
        ]
      },
      "payload": {
        "questId": {
          "fromFact": "campaignLog.latestCompletedPartyRaidRecord.questId.names.0"
        },
        "selectedHeroIds": {
          "fromFact": "campaignLog.latestCompletedPartyRaidRecord.heroGuids",
          "map": "stringArray"
        },
        "selectedTrinketIds": {
          "fromFact": "heroes",
          "whereIn": {
            "path": "id",
            "valuesFromFact": "campaignLog.latestCompletedPartyRaidRecord.heroGuids"
          },
          "selectMany": "trinketIds",
          "selectManyMissing": "skip",
          "map": "stringArray",
          "distinct": true
        },
        "saveStateReportPath": {
          "fromBridge": "saveStateReportPath"
        }
      }
    },
    {
      "id": "emit_boss_attempt_resolved_from_last_raid",
      "enabled": true,
      "emit": "quest.attempt_resolved",
      "phase": "normal",
      "priority": 0,
      "requiresCapabilities": [
        "state.sidecar",
        "quest.observe_attempt_resolved"
      ],
      "when": {
        "all": [
          {
            "state": "bossGauntlet.initialized",
            "op": "equals",
            "value": true
          },
          {
            "state": "bossGauntlet.phase",
            "op": "equals",
            "value": "boss_gauntlet"
          },
          {
            "state": "bossGauntlet.activeSelection.questId",
            "op": "exists"
          },
          {
            "fact": "progression.lastRaidQuest.names",
            "op": "contains",
            "valueFromState": "bossGauntlet.activeSelection.questId"
          },
          {
            "fact": "progression.lastRaidSuccess",
            "op": "exists"
          },
          {
            "fact": "campaignLog.partyRaidRecordCount",
            "op": "exists"
          },
          {
            "any": [
              {
                "state": "bossGauntlet.lastResolvedAttemptId",
                "op": "notExists"
              },
              {
                "state": "bossGauntlet.lastResolvedAttemptId",
                "op": "notEquals",
                "valueFromFact": "campaignLog.partyRaidRecordCount"
              }
            ]
          }
        ]
      },
      "payload": {
        "questId": {
          "fromState": "bossGauntlet.activeSelection.questId"
        },
        "success": {
          "fromFact": "progression.lastRaidSuccess"
        },
        "attemptId": {
          "fromFact": "campaignLog.partyRaidRecordCount"
        },
        "observedQuestHash": {
          "fromFact": "progression.lastRaidQuestId",
          "optional": true
        },
        "observedQuestNames": {
          "fromFact": "progression.lastRaidQuest.names"
        },
        "saveStateReportPath": {
          "fromBridge": "saveStateReportPath"
        }
      }
    }
  ],
  "eventRules": [
    {
      "id": "initialize_new_boss_gauntlet_profile",
      "enabled": true,
      "on": "profile.initialization_requested",
      "phase": "normal",
      "priority": 0,
      "requiresCapabilities": [
        "state.sidecar",
        "profile.detect_new_or_uninitialized",
        "roster.ensure_class_instances",
        "roster.set_progression",
        "roster.set_skill_unlocks",
        "upgrade.ensure_purchases",
        "stagecoach.suppress_recruits",
        "estate.ensure_inventory_counts",
        "wallet.set_currency_amounts",
        "trinket.patch_entry",
        "campaign.reset_plot_progress",
        "town.unlock_all_buildings",
        "quest_board.replace_with_fixed_set",
        "profile.mark_initialized"
      ],
      "when": {
        "all": [
          {
            "state": "bossGauntlet.initialized",
            "op": "equals",
            "value": false
          }
        ]
      },
      "actions": [
        {
          "type": "state.mergeDefinition",
          "capability": "state.sidecar",
          "risk": "safe",
          "required": true,
          "args": {
            "stateKey": "bossGauntlet",
            "definition": "boss_gauntlet.json",
            "overwriteExisting": true
          }
        },
        {
          "type": "roster.ensureClassInstances",
          "capability": "roster.ensure_class_instances",
          "risk": "managed",
          "required": true,
          "args": {
            "target": "profile.roster",
            "classSource": "content.hero_classes.enabled",
            "copiesPerClass": "state.bossGauntlet.heroCopiesPerClass",
            "level": "state.bossGauntlet.heroLevel",
            "positiveQuirks": "state.bossGauntlet.heroQuirks.positive",
            "negativeQuirks": "state.bossGauntlet.heroQuirks.negative",
            "nameSource": "state.bossGauntlet.heroNames.source",
            "nameLanguage": "state.bossGauntlet.heroNames.language",
            "nameSeed": "state.bossGauntlet.heroNames.seed",
            "nameRenamePolicy": "state.bossGauntlet.heroNames.renamePolicy"
          }
        },
        {
          "type": "roster.setProgression",
          "capability": "roster.set_progression",
          "risk": "managed",
          "required": true,
          "args": {
            "target": "profile.roster",
            "level": "state.bossGauntlet.heroLevel",
            "equipment": "max",
            "resolveXp": "max"
          }
        },
        {
          "type": "roster.setSkillUnlocks",
          "capability": "roster.set_skill_unlocks",
          "risk": "managed",
          "required": true,
          "args": {
            "target": "profile.roster",
            "skills": "state.bossGauntlet.skills"
          }
        },
        {
          "type": "upgrade.ensurePurchases",
          "capability": "upgrade.ensure_purchases",
          "risk": "managed",
          "required": true,
          "args": {
            "target": "profile.upgrades",
            "source": "state.bossGauntlet.upgrades.source",
            "mode": "state.bossGauntlet.upgrades.mode",
            "categories": "state.bossGauntlet.upgrades.categories",
            "instanceSource": "state.bossGauntlet.upgrades.instanceSource"
          }
        },
        {
          "type": "stagecoach.suppressRecruits",
          "capability": "stagecoach.suppress_recruits",
          "risk": "managed",
          "required": true,
          "args": {
            "target": "profile.stagecoach",
            "mode": "state.bossGauntlet.stageCoachRecruits"
          }
        },
        {
          "type": "estate.ensureInventoryCounts",
          "capability": "estate.ensure_inventory_counts",
          "risk": "managed",
          "required": true,
          "args": {
            "target": "profile.estate.inventory",
            "itemKind": "trinket",
            "source": "content.trinkets.enabled",
            "count": "state.bossGauntlet.trinketCopies",
            "excludeRarities": "state.bossGauntlet.initialTrinketExcludeRarities"
          }
        },
        {
          "type": "wallet.setCurrencyAmounts",
          "capability": "wallet.set_currency_amounts",
          "risk": "managed",
          "required": true,
          "args": {
            "target": "profile.wallet",
            "amounts": "state.bossGauntlet.initialCurrencies"
          }
        },
        {
          "type": "trinket.patchEntry",
          "capability": "trinket.patch_entry",
          "risk": "managed",
          "required": true,
          "args": {
            "target": "content.trinkets.entries",
            "enabled": "state.bossGauntlet.trinketSaleValuePatch.enabled",
            "items": [
              {
                "where": {
                  "rarity": "state.bossGauntlet.trinketSaleValuePatch.rarities"
                },
                "set": {
                  "price": "state.bossGauntlet.trinketSaleValuePatch.price"
                }
              }
            ]
          }
        },
        {
          "type": "campaign.resetPlotProgress",
          "capability": "campaign.reset_plot_progress",
          "risk": "managed",
          "required": true,
          "args": {
            "target": "profile.campaign_progress",
            "plotQuestIds": "state.bossGauntlet.resetPlotProgress.plotQuestIds",
            "clearHeroDarkestDungeonProgress": "state.bossGauntlet.resetPlotProgress.clearHeroDarkestDungeonProgress"
          }
        },
        {
          "type": "town.unlockAllBuildings",
          "capability": "town.unlock_all_buildings",
          "risk": "managed",
          "required": true,
          "args": {
            "target": "profile.town",
            "mode": "state.bossGauntlet.townBuildings"
          }
        },
        {
          "type": "town.suppressStoreItems",
          "capability": "town.suppress_store_items",
          "risk": "managed",
          "required": true,
          "args": {
            "target": "profile.town.stores",
            "mode": "state.bossGauntlet.townStoreItems.mode",
            "buildingIds": "state.bossGauntlet.townStoreItems.buildingIds",
            "sections": "state.bossGauntlet.townStoreItems.sections"
          }
        },
        {
          "type": "questBoard.replaceWithFixedSet",
          "capability": "quest_board.replace_with_fixed_set",
          "risk": "managed",
          "required": true,
          "args": {
            "target": "profile.quest_board",
            "questIds": "state.bossGauntlet.fixedQuestIds",
            "quests": "state.bossGauntlet.fixedBossQuests",
            "removeCompleted": true,
            "completedStateKey": "bossGauntlet.completedQuestIds"
          }
        },
        {
          "type": "state.setValue",
          "capability": "state.sidecar",
          "risk": "safe",
          "required": true,
          "args": {
            "key": "bossGauntlet.wallet.gold",
            "value": "state.bossGauntlet.initialCurrencies.gold"
          }
        },
        {
          "type": "state.setValue",
          "capability": "state.sidecar",
          "risk": "safe",
          "required": true,
          "args": {
            "key": "bossGauntlet.phase",
            "value": "boss_gauntlet"
          }
        },
        {
          "type": "state.setValue",
          "capability": "profile.mark_initialized",
          "risk": "safe",
          "required": true,
          "args": {
            "key": "bossGauntlet.initialized",
            "value": true
          }
        }
      ]
    },
    {
      "id": "record_observed_dead_heroes",
      "enabled": true,
      "on": "profile.dead_hero_observed",
      "phase": "normal",
      "priority": 0,
      "requiresCapabilities": [
        "state.sidecar"
      ],
      "actions": [
        {
          "type": "state.addUniqueRange",
          "capability": "state.sidecar",
          "risk": "safe",
          "required": true,
          "args": {
            "key": "bossGauntlet.observedDeadHeroIds",
            "fromEvent": "heroIds"
          }
        }
      ]
    },
    {
      "id": "lock_prefinale_boss_selection",
      "enabled": true,
      "on": "quest.selection_confirmed",
      "phase": "normal",
      "priority": 0,
      "requiresCapabilities": [
        "state.sidecar",
        "quest.observe_selection_confirmed",
        "party.observe_selection_confirmed",
        "equipment.observe_loadout_confirmed",
        "selection.lock"
      ],
      "when": {
        "all": [
          {
            "state": "bossGauntlet.phase",
            "op": "equals",
            "value": "boss_gauntlet"
          }
        ]
      },
      "actions": [
        {
          "type": "selection.lock",
          "capability": "selection.lock",
          "risk": "safe",
          "required": true,
          "args": {
            "stateKey": "bossGauntlet.activeSelection",
            "questId": "event.questId",
            "heroIds": "event.selectedHeroIds",
            "trinketIds": "event.selectedTrinketIds"
          }
        }
      ]
    },
    {
      "id": "resolve_successful_prefinale_boss_attempt",
      "enabled": true,
      "on": "quest.attempt_resolved",
      "phase": "normal",
      "priority": 0,
      "requiresCapabilities": [
        "state.sidecar",
        "quest.observe_attempt_resolved",
        "attempt.record_once",
        "selection.consume_heroes",
        "selection.consume_trinkets",
        "wallet.modify_currency",
        "quest.mark_completed",
        "state.transition_phase"
      ],
      "when": {
        "all": [
          {
            "state": "bossGauntlet.phase",
            "op": "equals",
            "value": "boss_gauntlet"
          },
          {
            "state": "bossGauntlet.activeSelection.questId",
            "op": "exists"
          },
          {
            "event": "success",
            "op": "equals",
            "value": true
          }
        ]
      },
      "actions": [
        {
          "type": "attempt.recordOnce",
          "capability": "attempt.record_once",
          "risk": "safe",
          "required": true,
          "args": {
            "stateKey": "bossGauntlet.attempts",
            "fingerprint": "event.attemptId",
            "selectionStateKey": "bossGauntlet.activeSelection"
          }
        },
        {
          "type": "state.setValue",
          "capability": "state.sidecar",
          "risk": "safe",
          "required": true,
          "args": {
            "key": "bossGauntlet.lastResolvedAttemptId",
            "value": "event.attemptId"
          }
        },
        {
          "type": "selection.consumeHeroes",
          "capability": "selection.consume_heroes",
          "risk": "safe",
          "required": true,
          "args": {
            "key": "bossGauntlet.consumedHeroIds",
            "selectionStateKey": "bossGauntlet.activeSelection"
          }
        },
        {
          "type": "selection.consumeTrinkets",
          "capability": "selection.consume_trinkets",
          "risk": "safe",
          "required": true,
          "args": {
            "key": "bossGauntlet.consumedTrinketIds",
            "selectionStateKey": "bossGauntlet.activeSelection"
          }
        },
        {
          "type": "wallet.addCurrencyOnEvent",
          "capability": "wallet.modify_currency",
          "risk": "safe",
          "required": true,
          "args": {
            "key": "bossGauntlet.wallet.gold",
            "amount": "state.bossGauntlet.victoryGold",
            "success": "event.success",
            "fingerprint": "event.attemptId",
            "fingerprintStateKey": "bossGauntlet.rewardedAttemptFingerprints"
          }
        },
        {
          "type": "quest.markCompletedIfSuccessful",
          "capability": "quest.mark_completed",
          "risk": "safe",
          "required": true,
          "args": {
            "key": "bossGauntlet.completedQuestIds",
            "questId": "event.questId",
            "success": "event.success"
          }
        },
        {
          "type": "state.transitionWhenAllCompleted",
          "capability": "state.transition_phase",
          "risk": "safe",
          "required": true,
          "args": {
            "completedKey": "bossGauntlet.completedQuestIds",
            "requiredKey": "bossGauntlet.fixedQuestIds",
            "phaseKey": "bossGauntlet.phase",
            "to": "darkest_finale",
            "clearPaths": [
              "bossGauntlet.consumedHeroIds",
              "bossGauntlet.consumedTrinketIds"
            ],
            "clearValue": []
          }
        },
        {
          "type": "state.setValue",
          "capability": "state.sidecar",
          "risk": "safe",
          "required": true,
          "args": {
            "key": "bossGauntlet.activeSelection",
            "value": null
          }
        }
      ]
    },
    {
      "id": "resolve_failed_prefinale_boss_attempt",
      "enabled": true,
      "on": "quest.attempt_resolved",
      "phase": "normal",
      "priority": 2,
      "requiresCapabilities": [
        "state.sidecar",
        "quest.observe_attempt_resolved",
        "attempt.record_once",
        "selection.consume_heroes",
        "selection.consume_trinkets"
      ],
      "when": {
        "all": [
          {
            "state": "bossGauntlet.phase",
            "op": "equals",
            "value": "boss_gauntlet"
          },
          {
            "state": "bossGauntlet.activeSelection.questId",
            "op": "exists"
          },
          {
            "event": "success",
            "op": "equals",
            "value": false
          }
        ]
      },
      "actions": [
        {
          "type": "attempt.recordOnce",
          "capability": "attempt.record_once",
          "risk": "safe",
          "required": true,
          "args": {
            "stateKey": "bossGauntlet.attempts",
            "fingerprint": "event.attemptId",
            "selectionStateKey": "bossGauntlet.activeSelection"
          }
        },
        {
          "type": "state.setValue",
          "capability": "state.sidecar",
          "risk": "safe",
          "required": true,
          "args": {
            "key": "bossGauntlet.lastResolvedAttemptId",
            "value": "event.attemptId"
          }
        },
        {
          "type": "selection.consumeHeroes",
          "capability": "selection.consume_heroes",
          "risk": "safe",
          "required": true,
          "args": {
            "key": "bossGauntlet.consumedHeroIds",
            "selectionStateKey": "bossGauntlet.activeSelection"
          }
        },
        {
          "type": "selection.consumeTrinkets",
          "capability": "selection.consume_trinkets",
          "risk": "safe",
          "required": true,
          "args": {
            "key": "bossGauntlet.consumedTrinketIds",
            "selectionStateKey": "bossGauntlet.activeSelection"
          }
        },
        {
          "type": "state.setValue",
          "capability": "state.sidecar",
          "risk": "safe",
          "required": true,
          "args": {
            "key": "bossGauntlet.activeSelection",
            "value": null
          }
        }
      ]
    }
  ],
  "stateSchema": {
    "bossGauntlet": {
      "type": "object",
      "default": {
        "initialized": false,
        "phase": "uninitialized",
        "wallet": {
          "gold": 0
