{
  "id": "validation.challenge_run_contract",
  "name": "Validation - Challenge Run Contract",
  "version": "0.1.0",
  "enabled": true,
  "capabilities": [
    "state.sidecar",
    "challenge.define_stage_chain",
    "challenge.observe_stage_selection_started",
    "challenge.observe_stage_selection_confirmed",
    "challenge.observe_stage_completed",
    "challenge.observe_stage_failed",
    "selection.lock",
    "attempt.record_once",
    "roster.provide_fixed_hero_pool",
    "roster.filter_available_heroes",
    "equipment.provide_fixed_trinket_pool",
    "equipment.filter_available_trinkets",
    "quest.inject_fixed_stage"
  ],
  "phase": "normal",
  "priority": 15,
  "virtualFileRules": [],
  "factEventRules": [
    {
      "id": "emit_stage_selection_confirmed_from_active_raid",
      "enabled": true,
      "emit": "challenge.stage_selection_confirmed",
      "phase": "normal",
      "priority": -10,
      "requiresCapabilities": [
        "state.sidecar",
        "challenge.observe_stage_selection_confirmed"
      ],
      "when": {
        "all": [
          {
            "state": "challengeRun.enabled",
            "op": "equals",
            "value": true
          },
          {
            "state": "challengeRun.lockedStageSelection",
            "op": "notExists"
          },
          {
            "state": "challengeRun.currentStage.id",
            "op": "exists"
          },
          {
            "state": "challengeRun.currentStage.sourceQuestId",
            "op": "exists"
          },
          {
            "state": "challengeRun.partySize",
            "op": "exists"
          },
          {
            "fact": "raid.instance.id",
            "op": "equals",
            "valueFromState": "challengeRun.currentStage.sourceQuestId"
          },
          {
            "fact": "raid.party.heroCount",
            "op": "equals",
            "valueFromState": "challengeRun.partySize"
          }
        ]
      },
      "payload": {
        "stageId": {
          "fromState": "challengeRun.currentStage.id"
        },
        "sourceQuestId": {
          "fromFact": "raid.instance.id"
        },
        "selectedHeroIds": {
          "fromFact": "raid.party.heroGuids",
          "map": "stringArray"
        },
        "selectedTrinketIds": {
          "fromFact": "heroes",
          "whereIn": {
            "path": "id",
            "valuesFromFact": "raid.party.heroGuids"
          },
          "selectMany": "trinketIds",
          "selectManyMissing": "skip",
          "map": "stringArray",
          "distinct": true
        },
        "saveStateReportPath": {
          "fromBridge": "saveStateReportPath"
        }
      }
    },
    {
      "id": "emit_stage_selection_confirmed_from_completed_campaign_log",
      "enabled": true,
      "emit": "challenge.stage_selection_confirmed",
      "phase": "normal",
      "priority": -5,
      "requiresCapabilities": [
        "state.sidecar",
        "challenge.observe_stage_selection_confirmed"
      ],
      "when": {
        "all": [
          {
            "state": "challengeRun.enabled",
            "op": "equals",
            "value": true
          },
          {
            "state": "challengeRun.lockedStageSelection",
            "op": "notExists"
          },
          {
            "state": "challengeRun.currentStage.id",
            "op": "exists"
          },
          {
            "state": "challengeRun.currentStage.sourceQuestId",
            "op": "exists"
          },
          {
            "fact": "campaignLog.latestCompletedPartyRaidRecord.questId.names",
            "op": "contains",
            "valueFromState": "challengeRun.currentStage.sourceQuestId"
          },
          {
            "fact": "campaignLog.latestCompletedPartyRaidRecord.start",
            "op": "equals",
            "value": false
          },
          {
            "fact": "campaignLog.latestCompletedPartyRaidRecord.success",
            "op": "equals",
            "value": true
          }
        ]
      },
      "payload": {
        "stageId": {
          "fromState": "challengeRun.currentStage.id"
        },
        "sourceQuestId": {
          "fromState": "challengeRun.currentStage.sourceQuestId"
        },
        "selectedHeroIds": {
          "fromFact": "campaignLog.partyRaidRecords",
          "where": {
            "all": [
              {
                "path": "questId.names",
                "op": "contains",
                "valueFromState": "challengeRun.currentStage.sourceQuestId"
              },
              {
                "path": "start",
                "op": "equals",
                "value": false
              },
              {
                "path": "success",
                "op": "equals",
                "value": true
              }
            ]
          },
          "selectMany": "heroGuids",
          "map": "stringArray"
        },
        "selectedTrinketIds": {
          "fromFact": "heroes",
          "whereIn": {
            "path": "id",
            "valuesFromFact": "campaignLog.latestCompletedPartyRaidRecord.heroGuids"
          },
          "selectMany": "trinketIds",
          "selectManyMissing": "skip",
          "map": "stringArray",
          "distinct": true
        },
        "saveStateReportPath": {
          "fromBridge": "saveStateReportPath"
        }
      }
    },
    {
      "id": "emit_stage_completed_from_last_raid",
      "enabled": true,
      "emit": "challenge.stage_completed",
      "phase": "normal",
      "priority": 0,
      "requiresCapabilities": [
        "state.sidecar",
        "challenge.observe_stage_completed"
      ],
      "when": {
        "all": [
          {
            "state": "challengeRun.enabled",
            "op": "equals",
            "value": true
          },
          {
            "state": "challengeRun.lockedStageSelection",
            "op": "exists"
          },
          {
            "state": "challengeRun.currentStage.id",
            "op": "exists"
          },
          {
            "state": "challengeRun.currentStage.sourceQuestId",
            "op": "exists"
          },
          {
            "fact": "progression.lastRaidSuccess",
            "op": "equals",
            "value": true
          },
          {
            "fact": "progression.lastRaidQuest.names",
            "op": "contains",
            "valueFromState": "challengeRun.currentStage.sourceQuestId"
          }
        ]
      },
      "payload": {
        "stageId": {
          "fromState": "challengeRun.currentStage.id"
        },
        "sourceQuestId": {
          "fromState": "challengeRun.currentStage.sourceQuestId"
        },
        "observedQuestHash": {
          "fromFact": "progression.lastRaidQuestId"
        },
        "observedQuestNames": {
          "fromFact": "progression.lastRaidQuest.names"
        },
        "observedSuccess": {
          "fromFact": "progression.lastRaidSuccess"
        },
        "saveStateReportPath": {
          "fromBridge": "saveStateReportPath"
        }
      }
    },
    {
      "id": "emit_stage_failed_from_last_raid",
      "enabled": true,
      "emit": "challenge.stage_failed",
      "phase": "normal",
      "priority": 0,
      "requiresCapabilities": [
        "state.sidecar",
        "challenge.observe_stage_failed"
      ],
      "when": {
        "all": [
          {
            "state": "challengeRun.enabled",
            "op": "equals",
            "value": true
          },
          {
            "state": "challengeRun.lockedStageSelection",
            "op": "exists"
          },
          {
            "state": "challengeRun.currentStage.id",
            "op": "exists"
          },
          {
            "state": "challengeRun.currentStage.sourceQuestId",
            "op": "exists"
          },
          {
            "fact": "progression.lastRaidSuccess",
            "op": "equals",
            "value": false
          },
          {
            "fact": "progression.lastRaidQuest.names",
            "op": "contains",
            "valueFromState": "challengeRun.currentStage.sourceQuestId"
          }
        ]
      },
      "payload": {
        "stageId": {
          "fromState": "challengeRun.currentStage.id"
        },
        "sourceQuestId": {
          "fromState": "challengeRun.currentStage.sourceQuestId"
        },
        "observedQuestHash": {
          "fromFact": "progression.lastRaidQuestId"
        },
        "observedQuestNames": {
          "fromFact": "progression.lastRaidQuest.names"
        },
        "observedSuccess": {
          "fromFact": "progression.lastRaidSuccess"
        },
        "observedPartyRaidRecordCount": {
          "fromFact": "campaignLog.partyRaidRecordCount",
          "optional": true
        },
        "saveStateReportPath": {
          "fromBridge": "saveStateReportPath"
        }
      }
    }
  ],
  "eventRules": [
    {
      "id": "initialize_challenge_run",
      "enabled": true,
      "on": "challenge.run_started",
      "phase": "normal",
      "priority": 0,
      "requiresCapabilities": [
        "state.sidecar",
        "challenge.define_stage_chain",
        "roster.provide_fixed_hero_pool",
        "equipment.provide_fixed_trinket_pool"
      ],
      "actions": [
        {
          "type": "challenge.initializeRunState",
          "capability": "state.sidecar",
          "risk": "safe",
          "required": true,
          "args": {
            "stateKey": "challengeRun",
            "definition": "challenge.json"
          }
        }
      ]
    },
    {
      "id": "prepare_stage_selection",
      "enabled": true,
      "on": "challenge.stage_selection_started",
      "phase": "normal",
      "priority": 0,
      "requiresCapabilities": [
        "state.sidecar",
        "challenge.observe_stage_selection_started",
        "roster.provide_fixed_hero_pool",
        "roster.filter_available_heroes",
        "equipment.provide_fixed_trinket_pool",
        "equipment.filter_available_trinkets",
        "quest.inject_fixed_stage"
      ],
      "when": {
        "all": [
          {
            "state": "challengeRun.enabled",
            "op": "equals",
            "value": true
          }
        ]
      },
      "actions": [
        {
          "type": "quest.injectFixedStage",
          "capability": "quest.inject_fixed_stage",
          "risk": "managed",
          "required": true,
          "args": {
            "stage": "state.challengeRun.currentStage",
            "source": "state.challengeRun.stages"
          }
        },
        {
          "type": "roster.filterAvailableHeroes",
          "capability": "roster.filter_available_heroes",
          "risk": "managed",
          "required": true,
          "args": {
            "source": "state.challengeRun.heroPool",
            "excludeStateList": "challengeRun.usedHeroIds",
            "lockedSelectionKey": "challengeRun.lockedStageSelection.heroIds"
          }
        },
        {
          "type": "equipment.filterAvailableTrinkets",
          "capability": "equipment.filter_available_trinkets",
          "risk": "managed",
          "required": true,
          "args": {
            "source": "state.challengeRun.trinketPool",
            "excludeStateList": "challengeRun.usedTrinketIds",
            "lockedSelectionKey": "challengeRun.lockedStageSelection.trinketIds"
          }
        }
      ]
    },
    {
      "id": "lock_stage_selection",
      "enabled": true,
      "on": "challenge.stage_selection_confirmed",
      "phase": "normal",
      "priority": 0,
      "requiresCapabilities": [
        "state.sidecar",
        "challenge.observe_stage_selection_confirmed",
        "selection.lock"
      ],
      "actions": [
        {
          "type": "selection.lock",
          "capability": "selection.lock",
          "risk": "safe",
          "required": true,
          "args": {
            "stateKey": "challengeRun.lockedStageSelection",
            "stageId": "event.stageId",
            "heroIds": "event.selectedHeroIds",
            "trinketIds": "event.selectedTrinketIds"
          }
        }
      ]
    },
    {
      "id": "complete_stage_and_consume_selection",
      "enabled": true,
      "on": "challenge.stage_completed",
      "phase": "normal",
      "priority": 0,
      "requiresCapabilities": [
        "state.sidecar",
        "challenge.observe_stage_completed",
        "attempt.record_once"
      ],
      "actions": [
        {
          "type": "state.addUniqueRange",
          "capability": "state.sidecar",
          "risk": "safe",
          "required": true,
          "args": {
            "key": "challengeRun.usedHeroIds",
            "fromState": "challengeRun.lockedStageSelection.heroIds"
          }
        },
        {
          "type": "state.addUniqueRange",
          "capability": "state.sidecar",
          "risk": "safe",
          "required": true,
          "args": {
            "key": "challengeRun.usedTrinketIds",
            "fromState": "challengeRun.lockedStageSelection.trinketIds"
          }
        },
        {
          "type": "state.addUnique",
          "capability": "state.sidecar",
          "risk": "safe",
          "required": true,
          "args": {
            "key": "challengeRun.completedStageIds",
            "value": "event.stageId"
          }
        },
        {
          "type": "attempt.recordOnce",
          "capability": "attempt.record_once",
          "risk": "safe",
          "required": true,
          "args": {
            "stateKey": "challengeRun.stageAttempts",
            "fingerprint": {
              "explicit": "event.attemptFingerprint",
              "requiresAny": [
                "event.observedAttemptId",
                "event.observedPartyRaidRecordCount"
              ],
              "prefix": "stageAttempt",
              "parts": {
                "stage": "event.stageId",
                "result": "completed",
                "attempt": "event.observedAttemptId",
                "partyRaidRecordCount": "event.observedPartyRaidRecordCount",
                "sourceQuestId": "event.sourceQuestId",
                "observedQuestHash": "event.observedQuestHash",
                "observedSuccess": "event.observedSuccess"
              }
            },
            "includeEvent": false,
            "fields": {
              "stageId": "event.stageId",
              "result": "completed"
            },
            "selectionStateKey": "challengeRun.lockedStageSelection",
            "selectionRequired": true
          }
        },
        {
          "type": "state.incrementCounter",
          "capability": "state.sidecar",
          "risk": "safe",
          "required": true,
          "args": {
            "key": "challengeRun.currentStageIndex",
            "amount": 1
          }
        },
        {
          "type": "state.setFromArrayIndex",
          "capability": "state.sidecar",
          "risk": "safe",
          "required": true,
          "args": {
            "key": "challengeRun.currentStage",
            "arrayStateKey": "challengeRun.stages",
            "indexStateKey": "challengeRun.currentStageIndex"
          }
        },
        {
          "type": "state.clearPaths",
          "capability": "state.sidecar",
          "risk": "safe",
          "required": true,
          "args": {
            "paths": [
              "challengeRun.lockedStageSelection"
            ]
          }
        }
      ]
    },
    {
      "id": "retry_keeps_locked_selection",
      "enabled": true,
      "on": "challenge.stage_failed",
      "phase": "normal",
      "priority": 0,
      "requiresCapabilities": [
        "state.sidecar",
        "challenge.observe_stage_failed",
        "attempt.record_once"
      ],
      "actions": [
        {
          "type": "attempt.recordOnce",
          "capability": "attempt.record_once",
          "risk": "safe",
          "required": true,
          "args": {
            "stateKey": "challengeRun.stageAttempts",
            "fingerprint": {
              "explicit": "event.attemptFingerprint",
              "requiresAny": [
                "event.observedAttemptId",
                "event.observedPartyRaidRecordCount"
              ],
              "prefix": "stageAttempt",
              "parts": {
                "stage": "event.stageId",
                "result": "failed",
                "attempt": "event.observedAttemptId",
                "partyRaidRecordCount": "event.observedPartyRaidRecordCount",
                "sourceQuestId": "event.sourceQuestId",
                "observedQuestHash": "event.observedQuestHash",
                "observedSuccess": "event.observedSuccess"
              }
            },
            "includeEvent": false,
            "fields": {
              "stageId": "event.stageId",
              "result": "failed"
            },
            "selectionStateKey": "challengeRun.lockedStageSelection",
            "selectionRequired": true
          }
        }
      ]
    }
  ],
  "stateSchema": {
    "challengeRun": {
      "type": "object",
      "default": {
        "enabled": true,
        "currentStageIndex": 0,
        "completedStageIds": [],
        "usedHeroIds": [],
        "usedTrinketIds": [],
        "lockedStageSelection": null,
        "stageAttempts": []
      }
    }
  }
}
